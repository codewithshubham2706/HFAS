# ─────────────────────────────────────────────────────────────
# HFAS — Healthcare Financial & Administrative Support
# Copy to .env and fill real values. NEVER commit .env.
# TODO(org): replace every <SET-ME> with org-managed secrets from
# your secret manager (AWS Secrets Manager / Vault). Do not email keys.
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# ── Database (Postgres) ──────────────────────────────────────
DATABASE_URL=postgres://hfas:hfas@localhost:5432/hfas
# TODO(org): in production use TLS: ?sslmode=require and a managed DB.
DB_SSL=false

# ── Auth / JWT ───────────────────────────────────────────────
# TODO(org): generate with `openssl rand -base64 48`; rotate per quarter.
JWT_ACCESS_SECRET=<SET-ME>
JWT_REFRESH_SECRET=<SET-ME>
JWT_ACCESS_TTL=900            # seconds (15 min)
JWT_REFRESH_TTL=2592000       # seconds (30 days)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# TODO(org): point at a real SMS/email provider before launch.
OTP_DEV_MODE=true             # returns OTP in response for local dev ONLY

# ── Object storage (S3-compatible; MinIO locally) ────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=hfas-documents
S3_ACCESS_KEY_ID=hfas
S3_SECRET_ACCESS_KEY=<SET-ME>
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=900

# ── Field-level encryption (KMS envelope encryption) ─────────
# TODO(org): create a KMS CMK; grant the app role kms:Encrypt/Decrypt only.
KMS_KEY_ARN=<SET-ME>
KMS_REGION=ap-south-1
# Local/dev fallback: app derives a key from this via HKDF. Never in prod.
FIELD_ENCRYPTION_DEV_KEY=<SET-ME>

# ── OCR adapter (mock | gcv) ─────────────────────────────────
OCR_PROVIDER=mock
# TODO(org): service account JSON path for Google Cloud Vision.
GOOGLE_APPLICATION_CREDENTIALS=
GCV_PROJECT_ID=

# ── Notifications (stubs until vendor keys exist) ────────────
# TODO(org): Twilio creds + approved sender ID (DLT registration in India).
SMS_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TODO(org): SendGrid API key + authenticated domain.
EMAIL_PROVIDER=stub
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@hfas.local

# ── Payments (PCI-DSS scope — do not enable without review) ──
# **REQUIRES LEGAL REVIEW** + PCI-DSS SAQ before enabling any payment flow.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=

# ── Webhooks ─────────────────────────────────────────────────
# Shared secret used to sign outbound webhook payloads (HMAC-SHA256).
WEBHOOK_SIGNING_SECRET=<SET-ME>

# ── Cookies / security ───────────────────────────────────────
COOKIE_DOMAIN=localhost
SECURE_COOKIES=false         # true behind HTTPS in prod
CSP_REPORT_ONLY=true
